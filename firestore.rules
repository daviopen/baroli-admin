rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function supportedProvider() { return signedIn() && request.auth.token.firebase.sign_in_provider in ['google.com', 'password']; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function hasProfile() { return supportedProvider() && exists(userPath(request.auth.uid)); }
    function profile() { return get(userPath(request.auth.uid)); }
    function activeUser() { return hasProfile() && profile().data.active == true; }
    function isSuperAdmin() { return activeUser() && profile().data.role == 'SUPER_ADMIN'; }
    function permissionPath(moduleName) { return /databases/$(database)/documents/permissions/$(request.auth.uid + '__' + moduleName); }
    function ownPermissionSlot(permissionId) {
      return activeUser() && permissionId in [request.auth.uid + '__dashboard', request.auth.uid + '__tasks', request.auth.uid + '__users', request.auth.uid + '__permissions', request.auth.uid + '__audit', request.auth.uid + '__clients', request.auth.uid + '__owners', request.auth.uid + '__tenants', request.auth.uid + '__properties', request.auth.uid + '__lease-termination', request.auth.uid + '__leases', request.auth.uid + '__inspections', request.auth.uid + '__maintenance', request.auth.uid + '__finance', request.auth.uid + '__documents'];
    }
    function explicitPermission(moduleName, acceptedLevels) {
      return activeUser() && exists(permissionPath(moduleName)) && get(permissionPath(moduleName)).data.userId == request.auth.uid && get(permissionPath(moduleName)).data.module == moduleName && get(permissionPath(moduleName)).data.level in acceptedLevels;
    }
    function canRead(moduleName) { return isSuperAdmin() || explicitPermission(moduleName, ['READ', 'EDIT']); }
    function canEdit(moduleName) { return isSuperAdmin() || explicitPermission(moduleName, ['EDIT']); }
    function ownLastAccessUpdate(userId) { return supportedProvider() && request.auth.uid == userId && resource.data.active == true && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastAccessAt']) && request.resource.data.lastAccessAt == request.time; }
    function ownProfileUpdate(userId) { return supportedProvider() && request.auth.uid == userId && resource.data.active == true && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'birthDate', 'photoURL', 'updatedAt']) && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 120 && request.resource.data.phone is string && request.resource.data.phone.size() <= 30 && request.resource.data.birthDate is string && request.resource.data.birthDate.size() <= 10 && request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 2048 && request.resource.data.updatedAt == request.time; }
    function validCreatedUser(userId) { return isSuperAdmin() && request.resource.data.uid == userId && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 160 && request.resource.data.email is string && request.resource.data.email.size() >= 3 && request.resource.data.email.size() <= 320 && request.resource.data.active == true && request.resource.data.role in ['USER', 'SUPER_ADMIN'] && request.resource.data.profileType in ['ADM_SUPER', 'CORRETOR', 'ADMINISTRATIVO', 'GESTAO'] && ((request.resource.data.profileType == 'ADM_SUPER' && request.resource.data.role == 'SUPER_ADMIN') || (request.resource.data.profileType != 'ADM_SUPER' && request.resource.data.role == 'USER')) && request.resource.data.createdBy == request.auth.uid && request.resource.data.updatedBy == request.auth.uid && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time; }
    function validManagedUserUpdate(userId) { let changed = request.resource.data.diff(resource.data).affectedKeys(); return isSuperAdmin() && changed.hasOnly(['name', 'active', 'role', 'profileType', 'updatedAt', 'updatedBy']) && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 160 && request.resource.data.active is bool && request.resource.data.role in ['USER', 'SUPER_ADMIN'] && request.resource.data.profileType in ['ADM_SUPER', 'CORRETOR', 'ADMINISTRATIVO', 'GESTAO'] && ((request.resource.data.profileType == 'ADM_SUPER' && request.resource.data.role == 'SUPER_ADMIN') || (request.resource.data.profileType != 'ADM_SUPER' && request.resource.data.role == 'USER')) && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time && (userId != request.auth.uid || (request.resource.data.active == true && request.resource.data.role == 'SUPER_ADMIN')); }
    function validManagedStatusUpdate(userId) { let changed = request.resource.data.diff(resource.data).affectedKeys(); return isSuperAdmin() && changed.hasOnly(['active', 'updatedAt', 'updatedBy']) && request.resource.data.active is bool && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time && (userId != request.auth.uid || request.resource.data.active == true); }
    function validPermissionDocument(permissionId) { return isSuperAdmin() && request.resource.data.userId is string && request.resource.data.module in ['dashboard', 'tasks', 'users', 'permissions', 'audit', 'clients', 'owners', 'tenants', 'properties', 'lease-termination', 'leases', 'inspections', 'maintenance', 'finance', 'documents'] && request.resource.data.level in ['READ', 'EDIT'] && permissionId == request.resource.data.userId + '__' + request.resource.data.module && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time; }
    function validAuditLogDocument() { return activeUser() && request.resource.data.keys().hasAll(['actorUserId', 'action', 'entityType', 'entityId', 'createdAt']) && request.resource.data.keys().hasOnly(['actorUserId', 'actorUserEmail', 'actorUserName', 'action', 'entityType', 'entityId', 'createdAt', 'details', 'before', 'after', 'reason']) && request.resource.data.actorUserId == request.auth.uid && request.resource.data.action is string && request.resource.data.action.size() >= 3 && request.resource.data.action.size() <= 80 && request.resource.data.action.matches('^[A-Z0-9_]+$') && request.resource.data.entityType is string && request.resource.data.entityType.size() > 0 && request.resource.data.entityType.size() <= 80 && request.resource.data.entityId is string && request.resource.data.entityId.size() > 0 && request.resource.data.entityId.size() <= 256 && request.resource.data.createdAt == request.time; }
    match /users/{userId} { allow get: if (supportedProvider() && request.auth.uid == userId) || canRead('users') || canRead('permissions') || canRead('tasks'); allow list: if canRead('users') || canRead('permissions') || canRead('tasks'); allow create: if validCreatedUser(userId); allow update: if ownLastAccessUpdate(userId) || ownProfileUpdate(userId) || validManagedUserUpdate(userId) || validManagedStatusUpdate(userId); allow delete: if false; }
    match /permissions/{permissionId} { allow get: if isSuperAdmin() || canRead('permissions') || ownPermissionSlot(permissionId); allow list: if isSuperAdmin() || canRead('permissions'); allow create, update: if validPermissionDocument(permissionId); allow delete: if isSuperAdmin(); }
    match /auditLogs/{logId} { allow read: if canRead('audit'); allow create: if validAuditLogDocument(); allow update, delete: if false; }
    match /tasks/{taskId} { allow read: if canRead('tasks'); allow create, update, delete: if canEdit('tasks'); }
    match /clients/{clientId} { allow read: if canRead('clients'); allow create, update: if canEdit('clients'); allow delete: if false; }
    match /properties/{propertyId} { allow read: if canRead('properties'); allow create, update: if canEdit('properties'); allow delete: if false; }
    match /leases/{leaseId} { allow read: if canRead('leases') || canRead('lease-termination'); allow create, update: if canEdit('leases') || canEdit('clients'); allow delete: if false; }
    match /leaseTerminations/{terminationId} { allow read: if canRead('lease-termination'); allow create, update: if canEdit('lease-termination'); allow delete: if false; }
    match /settings/{documentId} { allow read: if activeUser(); allow create, update, delete: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
