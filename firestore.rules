rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function supportedProvider() {
      return signedIn() && request.auth.token.firebase.sign_in_provider in ['google.com', 'password'];
    }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function hasProfile() { return supportedProvider() && exists(userPath(request.auth.uid)); }
    function profile() { return get(userPath(request.auth.uid)); }
    function activeUser() { return hasProfile() && profile().data.active == true; }
    function isSuperAdmin() { return activeUser() && profile().data.role == 'SUPER_ADMIN'; }
    function permissionPath(moduleName) {
      return /databases/$(database)/documents/permissions/$(request.auth.uid + '__' + moduleName);
    }
    function ownPermissionSlot(permissionId) {
      return activeUser() && permissionId in [
        request.auth.uid + '__dashboard',
        request.auth.uid + '__users',
        request.auth.uid + '__permissions',
        request.auth.uid + '__audit',
        request.auth.uid + '__owners',
        request.auth.uid + '__tenants',
        request.auth.uid + '__properties',
        request.auth.uid + '__leases',
        request.auth.uid + '__inspections',
        request.auth.uid + '__maintenance',
        request.auth.uid + '__finance',
        request.auth.uid + '__documents'
      ];
    }
    function explicitPermission(moduleName, acceptedLevels) {
      return activeUser()
        && exists(permissionPath(moduleName))
        && get(permissionPath(moduleName)).data.userId == request.auth.uid
        && get(permissionPath(moduleName)).data.module == moduleName
        && get(permissionPath(moduleName)).data.level in acceptedLevels;
    }
    function canRead(moduleName) {
      return isSuperAdmin() || explicitPermission(moduleName, ['READ', 'EDIT']);
    }
    function canEdit(moduleName) {
      return isSuperAdmin() || explicitPermission(moduleName, ['EDIT']);
    }
    function ownLastAccessUpdate(userId) {
      return supportedProvider()
        && request.auth.uid == userId
        && resource.data.active == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastAccessAt'])
        && request.resource.data.lastAccessAt == request.time;
    }

    match /users/{userId} {
      allow get: if (supportedProvider() && request.auth.uid == userId) || canRead('users') || canRead('permissions');
      allow list: if canRead('users') || canRead('permissions');
      allow update: if ownLastAccessUpdate(userId);
      allow create, delete: if false;
    }

    match /permissions/{permissionId} {
      allow get: if isSuperAdmin() || canRead('permissions') || ownPermissionSlot(permissionId);
      allow list: if isSuperAdmin() || canRead('permissions');
      allow create, update, delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if canRead('audit');
      allow create, update, delete: if false;
    }

    match /settings/{documentId} {
      allow read: if activeUser();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
